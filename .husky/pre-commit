#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run the WordPress formatter with our custom plugin
echo "Running wp-scripts format..."
npm run format

# If the script made changes, add those changes to the commit
if [ $? -eq 0 ]; then
  # Re-add any PHP files that were modified
  git diff --name-only | grep "\.php$" | xargs -r git add
fi
