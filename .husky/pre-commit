#!/usr/bin/env sh

# First sort PHP imports
for file in $(git diff --cached --name-only --diff-filter=ACMR | grep "\.php$"); do
  node bin/prettier/sort-php-imports.js "$file"
done

# Then check for unused imports
UNUSED_IMPORTS=0
for file in $(git diff --cached --name-only --diff-filter=ACMR | grep "\.php$"); do
  if ! node bin/prettier/check-unused-imports.js "$file"; then
    UNUSED_IMPORTS=1
  fi
done

# Exit if unused imports were found
if [ $UNUSED_IMPORTS -eq 1 ]; then
  exit 1
fi

# Run the WordPress formatter without showing all file output
npm run format > /dev/null 2>&1 || { echo "Formatting failed"; exit 1; }

git update-index --again
