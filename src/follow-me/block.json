{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "name": "activitypub/follow-me",
    "apiVersion": 3,
    "version": "2.0.0",
    "title": "Follow me on the Fediverse",
    "category": "widgets",
    "description": "Display your Fediverse profile so that visitors can follow you.",
    "textdomain": "activitypub",
    "icon": "groups",
    "example": {
        "attributes": {
            "buttonText": "Follow",
            "buttonOnly": false,
            "buttonSize": "default"
        }
    },
    "supports": {
        "html": false,
        "interactivity": true,
        "color": {
            "gradients": true,
            "link": true,
            "__experimentalDefaultControls": {
                "background": true,
                "text": true,
                "link": true
            }
        },
        "__experimentalBorder": {
            "radius": true,
            "width": true,
            "color": true,
            "style": true
        },
        "typography": {
            "fontSize": true,
            "__experimentalDefaultControls": {
                "fontSize": true
            }
        }
    },
    "attributes": {
        "selectedUser": {
            "type": "string",
            "default": "site"
        },
        "buttonOnly": {
            "type": "boolean",
            "default": false
        },
        "buttonText": {
            "type": "string",
            "default": "Follow"
        },
        "buttonSize": {
            "type": "string",
            "default": "default",
            "enum": [ "small", "default", "compact" ]
        }
    },
    "usesContext": [ "postType", "postId" ],
    "editorScript": "file:./index.js",
    "viewScriptModule": "file:./view.js",
    "style": "file:./style-view.css",
    "render": "file:./render.php"
}
