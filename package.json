{
	"name": "wordpress-activitypub",
	"description": "The ActivityPub protocol is a decentralized social networking protocol based upon the ActivityStreams 2.0 data format.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/automattic/wordpress-activitypub.git"
	},
	"author": {
		"name": "Matthias Pfefferle",
		"web": "https://notiz.blog"
	},
	"scripts": {
		"dev": "wp-scripts start --experimental-modules",
		"build": "rm -rf build && wp-scripts format && wp-scripts build --experimental-modules",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"test:unit": "wp-scripts test-unit-jest",
		"test:unit:watch": "wp-scripts test-unit-jest --watch",
		"test:unit:debug": "wp-scripts --inspect-brk test-unit-jest --runInBand --no-cache",
		"test:e2e": "wp-scripts test-playwright --config tests/e2e/playwright.config.js",
		"test:e2e:debug": "wp-scripts test-playwright --config tests/e2e/playwright.config.js --debug",
		"env": "wp-env",
		"env-start": "wp-env start",
		"env-stop": "wp-env stop",
		"env-test": "wp-env run tests-cli --env-cwd=\"wp-content/plugins/activitypub\" vendor/bin/phpunit",
		"release": "node bin/release.js",
		"prepare": "git config core.hooksPath .githooks"
	},
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/automattic/wordpress-activitypub/issues"
	},
	"homepage": "https://github.com/automattic/wordpress-activitypub#readme",
	"devDependencies": {
		"@babel/core": "^8.0.9",
		"@base-ui/react": "^1.9.0",
		"@playwright/test": "^1.64.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/jest": "^30.0.0",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/babel-preset-default": "^10.0.0",
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/commands": "^2.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/compose": "^9.0.0",
		"@wordpress/core-data": "^9.0.0",
		"@wordpress/data": "^11.0.0",
		"@wordpress/data-controls": "^5.0.0",
		"@wordpress/dataviews": "^21.0.0",
		"@wordpress/date": "^6.0.0",
		"@wordpress/dependency-extraction-webpack-plugin": "^7.0.0",
		"@wordpress/dom": "^5.0.0",
		"@wordpress/dom-ready": "^5.0.0",
		"@wordpress/e2e-test-utils-playwright": "^3.1.0",
		"@wordpress/edit-post": "^9.0.0",
		"@wordpress/editor": "^16.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/html-entities": "^5.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/icons": "^19.0.0",
		"@wordpress/interactivity": "^8.0.0",
		"@wordpress/interface": "^11.0.0",
		"@wordpress/jest-preset-default": "^14.2.0",
		"@wordpress/keyboard-shortcuts": "^6.0.0",
		"@wordpress/keycodes": "^5.0.0",
		"@wordpress/notices": "^6.0.0",
		"@wordpress/plugins": "^8.0.0",
		"@wordpress/preferences": "^5.0.0",
		"@wordpress/prettier-config": "^5.0.0",
		"@wordpress/primitives": "^5.0.0",
		"@wordpress/route": "^0.24.0",
		"@wordpress/scripts": "^36.1.0",
		"@wordpress/url": "^5.0.0",
		"@wordpress/viewport": "^7.0.0",
		"@wordpress/views": "^3.0.0",
		"babel-jest": "^30.5.2",
		"classnames": "^2.5.1",
		"clsx": "^2.1.1",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"prettier": "npm:wp-prettier@^3.0.3"
	}
}
